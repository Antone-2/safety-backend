NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crown_safety
# Production requires a non-local Redis 5.0.0+ instance for queues, scheduling, and cache coordination.
REDIS_URL=redis://your-redis-host:6379
REQUIRE_REDIS=true
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
GOOGLE_SHEETS_DATE_ORDER=dmy
SENTRY_DSN=

# Optional notification/storage settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
